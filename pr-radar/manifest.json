{
  "manifest_version": 3,
  "name": "PR Radar",
  "version": "0.1.0",
  "description": "Your open PRs, their checks, labels and linked Claude sessions in one side panel.",
  "permissions": ["storage", "alarms", "notifications", "sidePanel"],
  "host_permissions": ["https://api.github.com/*", "https://github.com/*", "https://claude.ai/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "PR Radar", "default_icon": "icon.png" },
  "icons": { "128": "icon.png" },
  "side_panel": { "default_path": "sidepanel.html" },
  "options_page": "options.html",
  "content_scripts": [{ "matches": ["https://claude.ai/code/*"], "js": ["content.js"], "run_at": "document_idle" }]
}
