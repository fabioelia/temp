{
  "manifest_version": 3,
  "name": "PR Radar",
  "version": "0.6.0",
  "description": "Your open PRs, their checks, labels and linked Claude sessions in one side panel.",
  "permissions": ["storage", "alarms", "notifications", "sidePanel", "downloads", "idle"],
  "host_permissions": [
    "https://api.github.com/*",
    "https://github.com/*",
    "https://claude.ai/*",
    "https://*.blob.core.windows.net/*",
    "https://*.actions.githubusercontent.com/*"
  ],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "PR Radar", "default_icon": "icon.png" },
  "icons": { "128": "icon.png" },
  "side_panel": { "default_path": "sidepanel.html" },
  "options_page": "options.html",
  "content_scripts": [{ "matches": ["https://claude.ai/code/*"], "js": ["content.js"], "run_at": "document_idle" }]
}
