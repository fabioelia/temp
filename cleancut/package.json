{
  "name": "cleancut",
  "version": "0.1.0",
  "private": true,
  "description": "Rate-your-own-cut: a browser extension that skips, mutes or blurs explicit scenes on Netflix and Prime Video, backed by a community database of timestamped content tags.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "cleancut-scan": "scanner/src/cli.js"
  },
  "scripts": {
    "build": "node extension/build.mjs",
    "package": "CLEANCUT_STORE=1 npm run build && cd extension/dist/chrome && rm -f ../cleancut-chrome.zip && zip -qr ../cleancut-chrome.zip . && echo Wrote extension/dist/cleancut-chrome.zip",
    "data:check": "node scripts/build-data.mjs --check",
    "data:build": "node scripts/build-data.mjs --out _site/data/v1",
    "site": "rm -rf _site && cp -r site _site && node scripts/build-data.mjs --out _site/data/v1",
    "watch": "node extension/build.mjs --watch",
    "server": "node --disable-warning=ExperimentalWarning server/src/index.js",
    "scan": "node scanner/src/cli.js",
    "demo:video": "sh scripts/make-demo-video.sh",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.js",
    "test:e2e": "CLEANCUT_DATA_BASE=http://127.0.0.1:8788/v1 npm run build && node --disable-warning=ExperimentalWarning test/e2e/extension.e2e.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  },
  "optionalDependencies": {
    "onnxruntime-node": "^1.31.1"
  }
}
